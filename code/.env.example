# LLM API Keys (ONLY CLAUDE REQUIRED!)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional API Keys (not needed for basic functionality)
# GOOGLE_API_KEY=
# OPENAI_API_KEY=

# Vector Database
CHROMA_PERSIST_DIRECTORY=./data_processed/vectorstore

# Model Configuration
PRIMARY_LLM=claude-sonnet-4-5
REASONING_LLM=claude-sonnet-4-5
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2

# RAG Configuration
RETRIEVAL_TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Agent Configuration
MAX_AGENT_RETRIES=3
AGENT_TIMEOUT=60

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/legal_ai.log

# Development
DEBUG=false
